{
    "name": "alfacode-team/hkm-plugin-school-frontdesk",
    "description": "The reception desk: visitor register, pupil pickups with delegates, and incoming mail (courriers).",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.4"
    },
    "autoload": {
        "psr-4": {
            "Plugins\\SchoolFrontdesk\\": ""
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Plugins\\SchoolFrontdesk\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
